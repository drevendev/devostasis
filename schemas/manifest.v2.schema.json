{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/drevendev/devostasis/schemas/manifest.v2.schema.json",
  "title": "Canonical manifest (devostasis.manifest.v2)",
  "description": "PV-BUNDLE-ID-003: complete receipt identity is always durable here; invocation receipts remain outside every canonical member.",
  "type": "object",
  "required": [
    "schema",
    "bundle_id",
    "project_key",
    "project_identity",
    "observed_at",
    "previous_bundle_id",
    "comparison_status",
    "supersedes_bundle_id",
    "artifact_contract_version",
    "bundle_identity_contract",
    "vitals_contract_version",
    "observation_contract_version",
    "ci_unit_contract_version",
    "policy_version",
    "config_version",
    "renderer_version",
    "canonical_serialization_version",
    "effective_config_contract",
    "effective_config_authority_contract",
    "effective_config_digest",
    "semantic_config",
    "canonical_member_profile",
    "adapters",
    "gauge_contract",
    "demand_contract",
    "identity_preimage",
    "members",
    "receipt_identity",
    "manifest_schema",
    "receipt_identity_schema",
    "receipt_identity_contract",
    "observations_schema"
  ],
  "properties": {
    "schema": {
      "const": "devostasis.manifest.v2"
    },
    "bundle_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "project_key": {
      "type": "string"
    },
    "project_identity": {
      "type": "object",
      "required": [
        "provider",
        "forge_instance",
        "immutable_project_id",
        "display_locator"
      ],
      "properties": {
        "provider": {
          "type": "string"
        },
        "forge_instance": {
          "type": "string"
        },
        "immutable_project_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "display_locator": {
          "type": "string"
        },
        "default_branch": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "observed_at": {
      "type": "string",
      "format": "date-time"
    },
    "previous_bundle_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "comparison_status": {
      "enum": [
        "BASELINE",
        "COMPARABLE",
        "HISTORY_GAP",
        "INCOMPARABLE"
      ]
    },
    "supersedes_bundle_id": {
      "const": null
    },
    "artifact_contract_version": {
      "const": "devostasis.bundle.v3"
    },
    "bundle_identity_contract": {
      "const": "PV-BUNDLE-ID-003"
    },
    "vitals_contract_version": {
      "const": "PV-VITALS-V1-002"
    },
    "observation_contract_version": {
      "const": "RAW-OBS-V0"
    },
    "ci_unit_contract_version": {
      "const": "PV-CI-UNIT-004"
    },
    "policy_version": {
      "type": "string"
    },
    "config_version": {
      "type": "string"
    },
    "renderer_version": {
      "const": "devostasis.render.v5"
    },
    "canonical_serialization_version": {
      "type": "string"
    },
    "effective_config_contract": {
      "const": "PV-EFFECTIVE-CONFIG-001"
    },
    "effective_config_authority_contract": {
      "const": "PV-EFFECTIVE-CONFIG-AUTHORITY-001"
    },
    "effective_config_digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "semantic_config": {
      "type": "object"
    },
    "canonical_member_profile": {
      "type": "object"
    },
    "adapters": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "provider",
          "adapter_version"
        ]
      }
    },
    "gauge_contract": {
      "const": "devostasis.gauge.v1"
    },
    "demand_contract": {
      "const": "devostasis.demand.v2"
    },
    "identity_preimage": {
      "type": "object",
      "required": [
        "bundle_identity_contract",
        "artifact_contract_version",
        "vitals_contract_version",
        "observation_contract_version",
        "ci_unit_contract_version",
        "policy_version",
        "config_version",
        "renderer_version",
        "canonical_serialization_version",
        "effective_config_contract",
        "effective_config_digest",
        "project_identity",
        "observed_at",
        "previous_bundle_id",
        "comparison_status",
        "snapshot_digest",
        "delta_digest",
        "activity_digest",
        "observations_digest",
        "source_receipts_digest",
        "gauge_contract",
        "demand_contract",
        "gauges_digest",
        "demand_digest",
        "manifest_schema",
        "observations_schema",
        "receipt_identity_contract",
        "receipt_identity_schema"
      ],
      "not": {
        "anyOf": [
          {
            "required": [
              "bundle_id"
            ]
          },
          {
            "required": [
              "members"
            ]
          },
          {
            "required": [
              "run_meta"
            ]
          }
        ]
      },
      "additionalProperties": false,
      "properties": {
        "bundle_identity_contract": {
          "const": "PV-BUNDLE-ID-003"
        },
        "artifact_contract_version": {
          "const": "devostasis.bundle.v3"
        },
        "vitals_contract_version": {
          "const": "PV-VITALS-V1-002"
        },
        "observation_contract_version": {
          "const": "RAW-OBS-V0"
        },
        "ci_unit_contract_version": {
          "const": "PV-CI-UNIT-004"
        },
        "policy_version": {
          "type": "string"
        },
        "config_version": {
          "type": "string"
        },
        "renderer_version": {
          "const": "devostasis.render.v5"
        },
        "canonical_serialization_version": {
          "type": "string"
        },
        "effective_config_contract": {
          "const": "PV-EFFECTIVE-CONFIG-001"
        },
        "effective_config_digest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "project_identity": {
          "type": "object",
          "required": [
            "provider",
            "forge_instance",
            "immutable_project_id",
            "display_locator"
          ],
          "properties": {
            "provider": {
              "type": "string"
            },
            "forge_instance": {
              "type": "string"
            },
            "immutable_project_id": {
              "type": [
                "string",
                "null"
              ]
            },
            "display_locator": {
              "type": "string"
            },
            "default_branch": {
              "type": [
                "string",
                "null"
              ]
            }
          }
        },
        "observed_at": {
          "type": "string",
          "format": "date-time"
        },
        "previous_bundle_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "comparison_status": {
          "enum": [
            "BASELINE",
            "COMPARABLE",
            "HISTORY_GAP",
            "INCOMPARABLE"
          ]
        },
        "snapshot_digest": {
          "type": "string"
        },
        "delta_digest": {
          "type": "string"
        },
        "activity_digest": {
          "type": "string"
        },
        "observations_digest": {
          "type": "string"
        },
        "source_receipts_digest": {
          "type": "string"
        },
        "gauge_contract": {
          "const": "devostasis.gauge.v1"
        },
        "demand_contract": {
          "const": "devostasis.demand.v2"
        },
        "gauges_digest": {
          "type": "string"
        },
        "demand_digest": {
          "type": "string"
        },
        "manifest_schema": {
          "const": "devostasis.manifest.v2"
        },
        "observations_schema": {
          "const": "devostasis.observations.v2"
        },
        "receipt_identity_contract": {
          "const": "PV-RECEIPT-IDENTITY-003"
        },
        "receipt_identity_schema": {
          "const": "devostasis.receipt-identity.v1"
        }
      }
    },
    "members": {
      "type": "object",
      "required": [
        "snapshot.json",
        "delta.json",
        "effective-config.json",
        "report.md"
      ],
      "additionalProperties": {
        "type": "string",
        "pattern": "^sha256:[0-9a-f]{64}$"
      }
    },
    "receipt_identity": {
      "$ref": "receipt-identity.schema.json"
    },
    "manifest_schema": {
      "const": "devostasis.manifest.v2"
    },
    "receipt_identity_schema": {
      "const": "devostasis.receipt-identity.v1"
    },
    "receipt_identity_contract": {
      "const": "PV-RECEIPT-IDENTITY-003"
    },
    "observations_schema": {
      "const": "devostasis.observations.v2"
    }
  },
  "additionalProperties": false
}
