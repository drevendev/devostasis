{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/drevendev/devostasis/schemas/conformance-vector.schema.json",
  "title": "Executable conformance vectors (devostasis.vectors.v1)",
  "type": "object",
  "required": ["schema", "vectors"],
  "additionalProperties": false,
  "properties": {
    "schema": { "const": "devostasis.vectors.v1" },
    "notes": { "type": "string" },
    "vectors": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["case", "title", "kind", "given"],
        "additionalProperties": false,
        "properties": {
          "case": { "type": "string", "minLength": 1, "description": "conformance case identifier; unique across the corpus and never reused" },
          "title": { "type": "string", "description": "what the case claims, in one sentence" },
          "kind": { "enum": ["vital", "delta", "ci", "activity"], "description": "what the runner executes; an unknown kind is an error, never a skip" },
          "source_unit": { "type": "string", "description": "research unit the case comes from" },
          "notes": { "type": "string" },
          "given": { "type": "object" },
          "expect": { "type": "object" }
        },
        "allOf": [
          {
            "if": { "properties": { "kind": { "const": "vital" } } },
            "then": {
              "required": ["expect"],
              "properties": {
                "given": {
                  "type": "object",
                  "required": ["vital"],
                  "additionalProperties": false,
                  "oneOf": [
                    { "required": ["observations"], "not": { "required": ["variants"] } },
                    { "required": ["variants"] }
                  ],
                  "properties": {
                    "vital": { "enum": ["horizon", "clutter", "direction", "flow", "integrity", "debt", "pulse"] },
                    "observed_at": { "type": "string" },
                    "subject": { "type": "object" },
                    "derive": {
                      "type": "object",
                      "description": "run the provider-neutral derivation over the stated inventories before evaluating, under these two project settings",
                      "required": ["planning_source"],
                      "additionalProperties": false,
                      "properties": {
                        "planning_source": { "enum": ["none", "milestones", "file"] },
                        "debt_mapping": { "type": ["object", "null"], "description": "the explicit debt mapping (labels or a register file), or null when none is configured" }
                      }
                    },
                    "observations": {
                      "type": "array",
                      "minItems": 1,
                      "items": { "$ref": "#/$defs/envelope" }
                    },
                    "variants": {
                      "type": "array",
                      "minItems": 2,
                      "description": "one obligation over several evidence shapes, all held to the one expect of the case",
                      "items": {
                        "type": "object",
                        "required": ["observations"],
                        "additionalProperties": false,
                        "properties": {
                          "title": { "type": "string", "description": "which shape of the case this is, used to name a failure" },
                          "observations": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/envelope" } }
                        }
                      }
                    }
                  }
                },
                "expect": { "$ref": "#/$defs/vital_expect" }
              }
            }
          },
          {
            "if": { "properties": { "kind": { "const": "delta" } } },
            "then": {
              "properties": {
                "given": {
                  "type": "object",
                  "description": "one comparison stated inline, or the comparisons of a case that names more than one pair",
                  "additionalProperties": false,
                  "oneOf": [
                    { "required": ["previous", "current"], "not": { "required": ["comparisons"] } },
                    { "required": ["comparisons"] }
                  ],
                  "properties": {
                    "comparison_status": { "enum": ["BASELINE", "COMPARABLE", "HISTORY_GAP", "INCOMPARABLE"] },
                    "previous_bundle_id": { "type": ["string", "null"] },
                    "incomparable_reasons": { "type": "array", "items": { "type": "string" } },
                    "previous": { "$ref": "#/$defs/side" },
                    "current": { "$ref": "#/$defs/side" },
                    "comparisons": {
                      "type": "array",
                      "minItems": 2,
                      "description": "an accepted case often names several pairs; each carries its own expect, and the case passes only when all of them do",
                      "items": {
                        "type": "object",
                        "required": ["previous", "current", "expect"],
                        "additionalProperties": false,
                        "properties": {
                          "title": { "type": "string", "description": "which pair of the case this is, used to name a failure" },
                          "comparison_status": { "enum": ["BASELINE", "COMPARABLE", "HISTORY_GAP", "INCOMPARABLE"] },
                          "previous_bundle_id": { "type": ["string", "null"] },
                          "incomparable_reasons": { "type": "array", "items": { "type": "string" } },
                          "previous": { "$ref": "#/$defs/side" },
                          "current": { "$ref": "#/$defs/side" },
                          "expect": { "$ref": "#/$defs/delta_expect" }
                        }
                      }
                    }
                  }
                },
                "expect": { "$ref": "#/$defs/delta_expect" }
              }
            }
          },
          {
            "if": { "properties": { "kind": { "const": "ci" } } },
            "then": {
              "required": ["expect"],
              "properties": {
                "given": {
                  "type": "object",
                  "description": "provider-native verification evidence stated inline, or the variants of a case that names several evidence shapes",
                  "additionalProperties": false,
                  "oneOf": [
                    { "required": ["revisions"], "not": { "required": ["variants"] } },
                    { "required": ["variants"] }
                  ],
                  "properties": {
                    "provider": { "enum": ["github"], "description": "whose native outcomes are normalized; a provider without a normalization in this version is an error" },
                    "observed_at": { "type": "string" },
                    "configured": { "type": ["boolean", "null"], "description": "the ci.configured observation handed to Integrity; null means not observed; default true" },
                    "series_status": { "enum": ["AVAILABLE", "PARTIAL", "UNAVAILABLE", "FORBIDDEN", "UNKNOWN", "ERROR"], "description": "acquisition status of the revision series handed to Integrity; default AVAILABLE" },
                    "revisions": { "$ref": "#/$defs/ci_revisions" },
                    "actions_runs": { "$ref": "#/$defs/ci_actions_runs" },
                    "check_suites": { "$ref": "#/$defs/ci_check_suites" },
                    "variants": {
                      "type": "array",
                      "minItems": 2,
                      "description": "one obligation over several provider-native evidence shapes (provider aliases, enumeration orders), all held to the one expect of the case",
                      "items": {
                        "type": "object",
                        "required": ["revisions"],
                        "additionalProperties": false,
                        "properties": {
                          "title": { "type": "string" },
                          "provider": { "enum": ["github"] },
                          "observed_at": { "type": "string" },
                          "configured": { "type": ["boolean", "null"] },
                          "series_status": { "enum": ["AVAILABLE", "PARTIAL", "UNAVAILABLE", "FORBIDDEN", "UNKNOWN", "ERROR"] },
                          "revisions": { "$ref": "#/$defs/ci_revisions" },
                          "actions_runs": { "$ref": "#/$defs/ci_actions_runs" },
                          "check_suites": { "$ref": "#/$defs/ci_check_suites" }
                        }
                      }
                    }
                  }
                },
                "expect": {
                  "type": "object",
                  "minProperties": 1,
                  "additionalProperties": false,
                  "properties": {
                    "revisions": {
                      "type": "object",
                      "description": "canonical revision records keyed by sha; every stated field is asserted, parents by position",
                      "additionalProperties": {
                        "type": "object",
                        "additionalProperties": false,
                        "properties": {
                          "current_verdict": { "type": ["string", "null"] },
                          "history_state": { "type": "string" },
                          "historical_contribution": { "type": ["string", "null"] },
                          "history_provenance": { "type": ["string", "null"] },
                          "parents": {
                            "type": "array",
                            "items": {
                              "type": "object",
                              "additionalProperties": false,
                              "properties": {
                                "parent_id": { "type": "string" },
                                "kind": { "type": "string" },
                                "current_state": { "type": "string" },
                                "history_state": { "type": "string" },
                                "current_attempt": { "type": ["integer", "null"] },
                                "attempts_observed": { "type": "array" },
                                "attempts_complete": { "type": "boolean" }
                              }
                            }
                          }
                        }
                      }
                    },
                    "integrity": { "$ref": "#/$defs/vital_expect" }
                  }
                }
              }
            }
          },
          {
            "if": { "properties": { "kind": { "const": "activity" } } },
            "then": {
              "required": ["expect"],
              "properties": {
                "given": {
                  "type": "object",
                  "required": ["observations"],
                  "additionalProperties": false,
                  "properties": {
                    "observed_at": { "type": "string" },
                    "previous_observed_at": { "type": ["string", "null"], "description": "observed_at of the previous successful bundle; absent or null is a BASELINE interval" },
                    "list_cap": { "type": "integer", "minimum": 0 },
                    "subject": { "type": "object" },
                    "observations": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/envelope" } }
                  }
                },
                "expect": {
                  "type": "object",
                  "minProperties": 1,
                  "additionalProperties": false,
                  "properties": {
                    "interval": {
                      "type": "object",
                      "additionalProperties": false,
                      "properties": {
                        "start": { "type": "string" },
                        "end": { "type": "string" },
                        "basis": { "enum": ["PREVIOUS_BUNDLE", "OBSERVATION_WINDOW_28D"] },
                        "exclusive_start": { "type": "boolean" }
                      }
                    },
                    "coverage_notes": { "type": "array", "items": { "type": "string" }, "description": "prefix matching, as for diagnostics" },
                    "coverage_notes_absent": { "type": "array", "items": { "type": "string" } },
                    "classes": {
                      "type": "object",
                      "description": "activity classes keyed by name; each holds the counts to assert, a checked subset",
                      "additionalProperties": { "type": "object", "additionalProperties": { "type": "integer" } }
                    },
                    "truncated": { "type": "object", "additionalProperties": { "type": "boolean" } }
                  }
                }
              }
            }
          }
        ]
      }
    }
  },
  "$defs": {
    "vital_expect": {
      "title": "What one Vital evaluation must yield",
      "description": "The same shape for a vital case and for the Integrity evaluation a ci case may chain into: a result to check, or the refusal a case about contradictory evidence expects.",
      "type": "object",
      "oneOf": [
        { "required": ["band", "evaluation_status"], "not": { "required": ["rejected"] } },
        { "required": ["rejected"], "maxProperties": 1 }
      ],
      "additionalProperties": false,
      "properties": {
        "band": { "type": ["string", "null"] },
        "evaluation_status": { "enum": ["AVAILABLE", "DEGRADED", "UNKNOWN"] },
        "band_semantics": { "type": ["string", "null"] },
        "possible_bands": { "type": ["array", "null"], "items": { "type": "string" } },
        "rule_id": { "type": "string" },
        "derived": { "type": "object" },
        "derived_absent": { "type": "array", "items": { "type": "string" } },
        "diagnostics": { "type": "array", "items": { "type": "string" } },
        "diagnostics_absent": { "type": "array", "items": { "type": "string" } },
        "explanation_contains": { "type": "array", "items": { "type": "string" } },
        "shared_signal_groups": { "type": "array", "items": { "type": "string" } },
        "dependency_group_ids": { "type": "array", "items": { "type": "string" } },
        "rejected": { "type": "string", "minLength": 1, "description": "the evidence must be refused before classification with this code (InadmissibleEvidence); the whole expectation of such a case" }
      }
    },
    "delta_expect": {
      "title": "What one comparison must classify",
      "description": "The same shape whether a case states one comparison inline or several under comparisons, so the two cannot drift apart.",
      "type": "object",
      "required": ["vitals"],
      "additionalProperties": false,
      "properties": {
        "comparison_status": { "enum": ["BASELINE", "COMPARABLE", "HISTORY_GAP", "INCOMPARABLE"] },
        "vitals": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": {
            "type": "object",
            "required": ["transition_class"],
            "additionalProperties": false,
            "properties": {
              "transition_class": { "enum": ["BASELINE", "UNCHANGED", "CHANGED", "IMPROVED", "WORSENED", "OBSERVABILITY_GAINED", "OBSERVABILITY_LOST", "INCOMPARABLE"] },
              "reason_codes": { "type": "array", "items": { "type": "string" } },
              "reason_codes_absent": { "type": "array", "items": { "type": "string" } },
              "metric_deltas": { "type": "object" },
              "coverage_delta": { "type": "array" }
            }
          }
        }
      }
    },
    "ci_revisions": {
      "type": "array",
      "minItems": 1,
      "description": "the immutable default-branch revisions of the window, as the commit inventory lists them",
      "items": {
        "type": "object",
        "required": ["sha", "committed_at"],
        "additionalProperties": false,
        "properties": { "sha": { "type": "string" }, "committed_at": { "type": "string" } }
      }
    },
    "ci_actions_runs": {
      "type": "array",
      "description": "GitHub Actions workflow runs as the provider reports them (id, head_sha, run_attempt, status, conclusion, ...), each with the earlier attempts the adapter would have fetched under prior_attempts",
      "items": {
        "type": "object",
        "required": ["id", "head_sha"],
        "properties": {
          "id": {},
          "head_sha": { "type": "string" },
          "run_attempt": { "type": "integer" },
          "status": { "type": ["string", "null"] },
          "conclusion": { "type": ["string", "null"] },
          "prior_attempts": { "type": "array", "items": { "type": "object", "required": ["run_attempt"] } }
        }
      }
    },
    "ci_check_suites": {
      "type": "object",
      "description": "check suites keyed by the sha they verify, as the provider reports them (id, status, conclusion, app.slug, ...)",
      "additionalProperties": { "type": "array", "items": { "type": "object", "required": ["id"] } }
    },
    "envelope": {
      "title": "Observation envelope as a vector states it",
      "description": "A vector states evidence, not a whole envelope. Only observation_id is required: the runner fills status AVAILABLE, provider, collected_at, source_ref and adapter_version, and the observation contract defaults value_type to count, freshness to FRESH and schema_version to RAW-OBS-V0. The completed envelope is then built through that contract (observation.schema.json), so evidence it rejects fails the vector rather than passing it.",
      "type": "object",
      "required": ["observation_id"],
      "additionalProperties": false,
      "properties": {
        "observation_id": { "type": "string", "minLength": 1 },
        "schema_version": { "const": "RAW-OBS-V0" },
        "provider": { "type": "string" },
        "collected_at": { "type": ["string", "null"], "format": "date-time" },
        "source_ref": { "type": ["string", "null"] },
        "status": { "enum": ["AVAILABLE", "PARTIAL", "UNAVAILABLE", "FORBIDDEN", "UNKNOWN", "ERROR"] },
        "freshness": { "enum": ["FRESH", "STALE", "UNKNOWN"] },
        "value_type": { "enum": ["count", "ratio", "duration", "boolean", "enum", "string", "set", "series", "record"] },
        "value": {},
        "coverage": { "type": ["object", "null"] },
        "evidence_ref": {},
        "adapter_version": { "type": ["string", "null"] },
        "reason_code": { "type": ["string", "null"] },
        "notes": { "type": ["string", "null"] }
      },
      "allOf": [
        {
          "if": { "required": ["status"], "properties": { "status": { "enum": ["UNAVAILABLE", "FORBIDDEN", "UNKNOWN", "ERROR"] } } },
          "then": { "properties": { "value": { "type": "null" } } }
        }
      ]
    },
    "side": {
      "type": "object",
      "required": ["vitals"],
      "additionalProperties": false,
      "properties": {
        "observed_at": { "type": "string" },
        "vitals": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["vital_id", "band"],
            "additionalProperties": false,
            "properties": {
              "vital_id": { "enum": ["horizon", "clutter", "direction", "flow", "integrity", "debt", "pulse"] },
              "band": { "type": ["string", "null"] },
              "evaluation_status": { "enum": ["AVAILABLE", "DEGRADED", "UNKNOWN"] },
              "band_semantics": { "type": ["string", "null"] },
              "rule_id": { "type": "string" },
              "derived": { "type": "object" },
              "inputs": { "type": "array" }
            }
          }
        }
      }
    }
  }
}
