{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/drevendev/Devostasis/schemas/code-packet.schema.json",
  "description": "Shape constraints; executable admission additionally enforces canonical bytes, source proofs, unique sorted paths, cross-field limits and exact replay.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract",
    "analysis_bundle_id",
    "subject",
    "budget",
    "files",
    "total_bytes",
    "authority",
    "packet_id"
  ],
  "properties": {
    "contract": {
      "const": "devostasis.code-packet.v1"
    },
    "analysis_bundle_id": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "subject": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "object_format",
        "roots",
        "repository_id",
        "revision",
        "tree"
      ],
      "properties": {
        "kind": {
          "const": "LOCAL_GIT"
        },
        "object_format": {
          "enum": [
            "sha1",
            "sha256"
          ]
        },
        "roots": {
          "type": "array",
          "minItems": 1,
          "maxItems": 256,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[0-9a-f]{40}([0-9a-f]{24})?$"
          }
        },
        "repository_id": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "revision": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}([0-9a-f]{24})?$"
        },
        "tree": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}([0-9a-f]{24})?$"
        }
      }
    },
    "budget": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "max_files",
        "max_bytes"
      ],
      "properties": {
        "max_files": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1000
        },
        "max_bytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 67108864
        }
      }
    },
    "files": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1000,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "path",
          "object_id",
          "size",
          "base64"
        ],
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1,
            "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))[^\\\\\\u0000-\\u001f]+$"
          },
          "object_id": {
            "type": "string",
            "pattern": "^[0-9a-f]{40}([0-9a-f]{24})?$"
          },
          "size": {
            "type": "integer",
            "minimum": 0,
            "maximum": 67108864
          },
          "base64": {
            "type": "string",
            "contentEncoding": "base64"
          }
        }
      }
    },
    "total_bytes": {
      "type": "integer",
      "minimum": 0,
      "maximum": 67108864
    },
    "authority": {
      "const": "PINNED_LOCAL_SOURCE_ONLY; no live freshness, independent acceptance or execution authority"
    },
    "packet_id": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    }
  }
}
